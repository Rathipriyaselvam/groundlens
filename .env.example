# ==============================================================================
# GroundLens Configuration Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Open-Weights LLM Configuration (Groq)
# ------------------------------------------------------------------------------
# GroundLens strictly relies on open-weights models served via Groq.
# Closed-weights models (GPT-4, Claude, Gemini) are disbarred from primary reasoning.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Community Discussion APIs
# ------------------------------------------------------------------------------
# Reddit API credentials via PRAW (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=GroundLens/1.0 (by /u/groundlens_app)

# Stack Exchange API (Optional key for increased rate limits from 300 to 10,000 req/day)
# https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=

# ------------------------------------------------------------------------------
# 3. Observability & Tracing (LangSmith)
# ------------------------------------------------------------------------------
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=groundlens
LANGCHAIN_TRACING_V2=true

# ------------------------------------------------------------------------------
# 4. Caching Configuration
# ------------------------------------------------------------------------------
CACHE_TTL_SECONDS=600
CACHE_DB_PATH=.cache.db
